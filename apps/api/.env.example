PORT=4000
MONGODB_URI=mongodb://127.0.0.1:27017/kraven
SESSION_SECRET=replace-with-a-long-random-string
REQUIRE_DATABASE=false

# Client portal: secret that signs the portal cookie, and the web origin serving /c/<slug> pages.
PORTAL_COOKIE_SECRET=replace-with-another-long-random-string
PORTAL_BASE_URL=http://localhost:5173

# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Object storage (MinIO / any S3-compatible API). Matches docker-compose.yml defaults.
S3_ENDPOINT=http://127.0.0.1:9000
# Optional: endpoint browsers can reach, used to sign presigned download URLs
# (set it when the API reaches storage by an internal hostname such as http://minio:9000).
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=kraven
S3_REGION=us-east-1

# HTML -> PDF rendering service.
GOTENBERG_URL=http://127.0.0.1:3000
GOTENBERG_TIMEOUT_MS=30000
# Gotenberg's Chromium fetches any URL in template HTML (e.g. <img src>). docker-compose.yml starts it
# with --chromium-deny-list blocking loopback, private, link-local and internal service hosts. In
# production also keep Gotenberg on an isolated network with no route to internal services.

# Agency details available to document templates as {{agency.*}}.
AGENCY_NAME=Kraven
AGENCY_EMAIL=
AGENCY_PHONE=
AGENCY_ADDRESS=
AGENCY_WEBSITE=

ADMIN_EMAIL_1=admin.one@example.com
ADMIN_PASSWORD_1=replace-with-a-strong-password
ADMIN_EMAIL_2=admin.two@example.com
ADMIN_PASSWORD_2=replace-with-a-strong-password

# Email via Resend. With RESEND_API_KEY unset, emails are only logged (EmailLog stays "queued").
RESEND_API_KEY=
EMAIL_FROM=Kraven <noreply@example.com>
# Svix signing secret (whsec_...) for POST /webhooks/resend; delivery events update EmailLog status.
RESEND_WEBHOOK_SECRET=

# Daily reminder job (unsigned docs, unpaid payment items, overdue invoices). Off by default.
REMINDERS_ENABLED=false
REMINDERS_CRON=0 9 * * *
REMINDER_AFTER_DAYS=3
