PORT=4000
MONGODB_URI=mongodb+srv://user:pass@cluster.example.net/kraven
SESSION_SECRET=replace-with-a-long-random-string
REQUIRE_DATABASE=false

# Client portal: secret that signs the portal cookie, and the web origin serving /c/<slug> pages.
PORTAL_COOKIE_SECRET=replace-with-another-long-random-string
PORTAL_BASE_URL=http://localhost:5173

# Comma-separated list of browser origins allowed to call the API with credentials.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Object storage: any hosted S3-compatible service (AWS S3, R2, etc.).
S3_ENDPOINT=https://s3.example.com
# Optional: endpoint browsers use for presigned download URLs; defaults to S3_ENDPOINT.
S3_PUBLIC_ENDPOINT=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_BUCKET=kraven
S3_REGION=us-east-1

# HTML -> PDF renders in-process with puppeteer (headless Chromium); all network requests are blocked.
PDF_TIMEOUT_MS=30000

# Agency details available to document templates as {{agency.*}}.
AGENCY_NAME=Kraven
AGENCY_EMAIL=
AGENCY_PHONE=
AGENCY_ADDRESS=
AGENCY_WEBSITE=

ADMIN_EMAIL_1=admin.one@example.com
ADMIN_PASSWORD_1=replace-with-a-strong-password
ADMIN_EMAIL_2=admin.two@example.com
ADMIN_PASSWORD_2=replace-with-a-strong-password

# Email via Resend. With RESEND_API_KEY unset, emails are only logged (EmailLog stays "queued").
RESEND_API_KEY=
EMAIL_FROM=Kraven <noreply@example.com>
# Svix signing secret (whsec_...) for POST /webhooks/resend; delivery events update EmailLog status.
RESEND_WEBHOOK_SECRET=

# Daily reminder job (unsigned docs, unpaid payment items, overdue invoices). Off by default.
REMINDERS_ENABLED=false
REMINDERS_CRON=0 9 * * *
REMINDER_AFTER_DAYS=3

# Google Drive + Docs (documents). Create an OAuth client (Web) and set the consent screen to "In production".
# Redirect URI must be <api>/google/oauth/callback. Tokens are stored in Mongo after "Connect Google" in the app.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/google/oauth/callback
# 32-byte key (64 hex chars) encrypting the stored refresh token. Generate: openssl rand -hex 32
GOOGLE_TOKEN_KEY=
GOOGLE_DRIVE_ROOT_FOLDER_NAME=Kraven Documents
# Google Doc copied for blank documents (defaults to the agency blank doc)
GOOGLE_BLANK_DOC_ID=1IoJZ9gJYvUXbaKMApZMwuFHo7Zu1ERIuspnwlRDOqzM
