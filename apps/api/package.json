    "test": "vitest run",
    "lint": "eslint src --ext .ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1176.0",
    "@aws-sdk/s3-request-presigner": "^3.1176.0",
    "@kraven/config": "*",
    "@kraven/types": "*",
    "@kraven/validation": "*",
    "bcrypt": "^6.0.0",
    "cookie-parser": "^1.4.6",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "express-rate-limit": "^8.7.5",
    "express-session": "^1.19.0",
    "handlebars": "^4.7.10",
    "helmet": "^8.3.0",
    "mongoose": "^8.5.2",
    "multer": "^2.3.0",
    "node-cron": "^4.6.0",
    "pdf-lib": "^1.17.1",
